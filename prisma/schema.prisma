generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum UserStatus { ACTIVE INACTIVE SUSPENDED }
enum Gender { MALE FEMALE OTHER }
enum VehicleStatus { AVAILABLE IN_LESSON MAINTENANCE INACTIVE }
enum TransmissionType { MANUAL AUTOMATIC }
enum FuelType { PETROL DIESEL HYBRID ELECTRIC }
enum LessonType { THEORY PRACTICAL EXAMINATION }
enum LessonStatus { SCHEDULED CONFIRMED IN_PROGRESS COMPLETED CANCELLED NO_SHOW }
enum AttendanceStatus { PRESENT ABSENT LATE EXCUSED CANCELLED }
enum ExamType { THEORY PRACTICAL FINAL }
enum ExamResult { SCHEDULED PASSED FAILED CANCELLED }
enum PaymentMethod { CASH CARD BANK_TRANSFER OTHER }
enum InvoiceStatus { DRAFT ISSUED PARTIAL PAID OVERDUE CANCELLED REFUNDED }
enum DocumentType { ID PHOTO LICENSE MEDICAL CONTRACT CERTIFICATE OTHER }
enum NotificationChannel { IN_APP EMAIL SMS WHATSAPP }
model User { id String @id @default(cuid()) email String @unique passwordHash String name String phone String? status UserStatus @default(ACTIVE) locale String @default("ku") roles UserRole[] student Student? instructor Instructor? notifications Notification[] auditLogs AuditLog[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Role { id String @id @default(cuid()) name String @unique description String? permissions RolePermission[] users UserRole[] createdAt DateTime @default(now()) }
model Permission { id String @id @default(cuid()) key String @unique description String? roles RolePermission[] }
model UserRole { userId String roleId String user User @relation(fields:[userId], references:[id], onDelete:Cascade) role Role @relation(fields:[roleId], references:[id], onDelete:Cascade) @@id([userId,roleId]) }
model RolePermission { roleId String permissionId String role Role @relation(fields:[roleId], references:[id], onDelete:Cascade) permission Permission @relation(fields:[permissionId], references:[id], onDelete:Cascade) @@id([roleId,permissionId]) }
model Student { id String @id @default(cuid()) studentCode String @unique userId String? @unique user User? @relation(fields:[userId], references:[id]) fullName String photoUrl String? phone String email String? address String? dateOfBirth DateTime? gender Gender? nationalId String? licenseCategory String registrationDate DateTime @default(now()) trainingStatus String @default("ACTIVE") examStatus String @default("PENDING") paymentStatus String @default("UNPAID") notes String? instructorId String? assignedVehicleId String? instructor Instructor? @relation(fields:[instructorId], references:[id]) assignedVehicle Vehicle? @relation(fields:[assignedVehicleId], references:[id]) enrollments Enrollment[] lessons Lesson[] exams Exam[] invoices Invoice[] payments Payment[] documents Document[] attendance LessonAttendance[] notifications Notification[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Instructor { id String @id @default(cuid()) userId String? @unique user User? @relation(fields:[userId], references:[id]) name String photoUrl String? phone String email String? licenseInfo String experienceYears Int @default(0) workingSchedule Json? availability Json? commissionRate Decimal @db.Decimal(5,2) @default(0) notes String? students Student[] vehicles Vehicle[] lessons Lesson[] exams Exam[] evaluations LessonEvaluation[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Vehicle { id String @id @default(cuid()) vehicleCode String @unique plateNumber String @unique make String model String year Int color String? transmission TransmissionType fuelType FuelType vin String? currentMileage Int @default(0) status VehicleStatus @default(AVAILABLE) instructorId String? instructor Instructor? @relation(fields:[instructorId], references:[id]) insuranceExpiry DateTime? registrationExpiry DateTime? maintenanceDate DateTime? notes String? students Student[] lessons Lesson[] maintenance MaintenanceRecord[] gpsSessions GpsSession[] }
model MaintenanceRecord { id String @id @default(cuid()) vehicleId String vehicle Vehicle @relation(fields:[vehicleId], references:[id], onDelete:Cascade) title String description String? cost Decimal? @db.Decimal(10,2) performedAt DateTime @default(now()) nextDueAt DateTime? }
model Package { id String @id @default(cuid()) name String description String? licenseCategory String theoryLessons Int practicalLessons Int price Decimal @db.Decimal(10,2) discount Decimal @db.Decimal(10,2) @default(0) durationDays Int validityDays Int active Boolean @default(true) enrollments Enrollment[] }
model Enrollment { id String @id @default(cuid()) studentId String packageId String student Student @relation(fields:[studentId], references:[id], onDelete:Cascade) package Package @relation(fields:[packageId], references:[id]) practicalCompleted Int @default(0) theoryCompleted Int @default(0) startsAt DateTime @default(now()) expiresAt DateTime? active Boolean @default(true) }
model Lesson { id String @id @default(cuid()) studentId String instructorId String vehicleId String? student Student @relation(fields:[studentId], references:[id]) instructor Instructor @relation(fields:[instructorId], references:[id]) vehicle Vehicle? @relation(fields:[vehicleId], references:[id]) startsAt DateTime endsAt DateTime location String type LessonType status LessonStatus @default(SCHEDULED) notes String? attendance LessonAttendance? evaluation LessonEvaluation? gpsSession GpsSession? exams Exam[] createdAt DateTime @default(now()) @@index([startsAt,endsAt]) }
model LessonAttendance { id String @id @default(cuid()) lessonId String @unique lesson Lesson @relation(fields:[lessonId], references:[id], onDelete:Cascade) studentId String student Student @relation(fields:[studentId], references:[id]) status AttendanceStatus notes String? recordedAt DateTime @default(now()) }
model LessonEvaluation { id String @id @default(cuid()) lessonId String @unique lesson Lesson @relation(fields:[lessonId], references:[id], onDelete:Cascade) instructorId String instructor Instructor @relation(fields:[instructorId], references:[id]) scores Json overallScore Decimal @db.Decimal(3,2) notes String? createdAt DateTime @default(now()) }
model GpsSession { id String @id @default(cuid()) lessonId String @unique lesson Lesson @relation(fields:[lessonId], references:[id], onDelete:Cascade) vehicleId String? vehicle Vehicle? @relation(fields:[vehicleId], references:[id]) startedAt DateTime @default(now()) endedAt DateTime? distanceMeters Int @default(0) durationSeconds Int @default(0) startLocation Json? endLocation Json? points GpsPoint[] }
model GpsPoint { id String @id @default(cuid()) sessionId String session GpsSession @relation(fields:[sessionId], references:[id], onDelete:Cascade) lat Decimal @db.Decimal(9,6) lng Decimal @db.Decimal(9,6) speedKph Decimal? @db.Decimal(6,2) recordedAt DateTime @default(now()) @@index([sessionId,recordedAt]) }
model Exam { id String @id @default(cuid()) studentId String examinerId String? lessonId String? student Student @relation(fields:[studentId], references:[id]) examiner Instructor? @relation(fields:[examinerId], references:[id]) lesson Lesson? @relation(fields:[lessonId], references:[id]) type ExamType scheduledAt DateTime result ExamResult @default(SCHEDULED) score Decimal? @db.Decimal(5,2) mistakes Json? notes String? certificateEligible Boolean @default(false) }
model Invoice { id String @id @default(cuid()) invoiceNumber String @unique studentId String student Student @relation(fields:[studentId], references:[id]) total Decimal @db.Decimal(10,2) discount Decimal @db.Decimal(10,2) @default(0) tax Decimal @db.Decimal(10,2) @default(0) finalTotal Decimal @db.Decimal(10,2) paidAmount Decimal @db.Decimal(10,2) @default(0) status InvoiceStatus @default(ISSUED) dueAt DateTime? payments Payment[] createdAt DateTime @default(now()) }
model Payment { id String @id @default(cuid()) paymentCode String @unique invoiceId String? studentId String invoice Invoice? @relation(fields:[invoiceId], references:[id]) student Student @relation(fields:[studentId], references:[id]) amount Decimal @db.Decimal(10,2) method PaymentMethod type String @default("PAYMENT") reference String? receivedAt DateTime @default(now()) }
model Expense { id String @id @default(cuid()) category String description String? amount Decimal @db.Decimal(10,2) spentAt DateTime @default(now()) }
model Document { id String @id @default(cuid()) studentId String? student Student? @relation(fields:[studentId], references:[id]) type DocumentType fileName String mimeType String sizeBytes Int storageKey String expiresAt DateTime? createdAt DateTime @default(now()) }
model Notification { id String @id @default(cuid()) userId String? studentId String? user User? @relation(fields:[userId], references:[id]) student Student? @relation(fields:[studentId], references:[id]) title String body String channel NotificationChannel @default(IN_APP) readAt DateTime? metadata Json? createdAt DateTime @default(now()) }
model Setting { id String @id @default(cuid()) key String @unique value Json updatedAt DateTime @updatedAt }
model AuditLog { id String @id @default(cuid()) userId String? user User? @relation(fields:[userId], references:[id]) action String entity String entityId String? ip String? metadata Json? createdAt DateTime @default(now()) }
